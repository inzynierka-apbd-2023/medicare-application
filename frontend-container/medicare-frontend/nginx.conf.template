server {
  absolute_redirect off;
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
  }

  location = /index.html {
    add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
  }

  # --- DYNAMIC PROXY CONFIGURATION (Envsubst) ---
  
  # Defaults for all proxies
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  # proxy_set_header X-Forwarded-Proto $scheme; # Removed to allow Azure Ingress header (https) to pass through
  proxy_set_header X-Forwarded-Host $host;
  
  # SSL Proxy Settings (Required for internal HTTPS)
  proxy_ssl_server_name on;
  proxy_ssl_verify off;
  proxy_ssl_protocols TLSv1.2 TLSv1.3;

  # Documents Service
  location = /api/documents { return 301 /api/documents/; }
  location /api/documents/ {
    proxy_pass ${DOCUMENTS_SERVICE_URL};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_cache_bypass $http_upgrade;
  }

  # Billing Service
  location = /api/billing { return 301 /api/billing/; }
  location /api/billing/ {
    proxy_pass ${BILLING_SERVICE_URL};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_cache_bypass $http_upgrade;
  }

  # Practitioner Service
  location /api/practitioner/ {
    proxy_pass ${PRACTITIONER_SERVICE_URL};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_cache_bypass $http_upgrade;
  }

  # Patient Service
  location /api/patient/ {
    proxy_pass ${PATIENT_SERVICE_URL};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_cache_bypass $http_upgrade;
  }

  # Appointment Service
  location /api/appointment/ {
    proxy_pass ${APPOINTMENT_SERVICE_URL};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_cache_bypass $http_upgrade;
  }

  # Notification Service
  location ^~ /api/notifications {
    proxy_pass ${NOTIFICATION_SERVICE_URL};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_cache_bypass $http_upgrade;
  }

  # Medical Catalog Service
  location /api/catalog/ {
    proxy_pass ${CATALOG_SERVICE_URL};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_cache_bypass $http_upgrade;
  }

  # Lab Service
  location /api/lab/ {
    proxy_pass ${LAB_SERVICE_URL};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_cache_bypass $http_upgrade;
  }

  # Medical Records Service
  location /api/medical-records/ {
    proxy_pass ${RECORDS_SERVICE_URL};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_cache_bypass $http_upgrade;
  }

  # Messaging Service
  location /api/messaging/ {
    proxy_pass ${MESSAGING_SERVICE_URL};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_cache_bypass $http_upgrade;
  }

  # User Service (Gateway/Fallback)
  location /api/ {
    proxy_pass ${USER_SERVICE_URL};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_cache_bypass $http_upgrade;
  }
}
