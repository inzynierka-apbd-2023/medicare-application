{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "NotificationDb": ""
    },
    "Jwt": {
        "Issuer": "MedicareApp",
        "Audience": "MedicareUsers",
        "SecretKey": "",
        "ExpiryInMinutes": 15
    },
    "RefreshToken": {
        "ExpiryInDays": 7,
        "CookiePath": "/api/auth/refresh"
    },
    "Cookie": {
        "HttpOnly": true,
        "Secure": true,
        "SameSite": "None"
    },
    "Cors": {
        "AllowedOrigins": []
    },
    "Smtp": {
        "Host": "smtp.gmail.com",
        "Port": 587,
        "Username": "INSERT_YOUR_GMAIL_HERE@gmail.com",
        "Password": "INSERT_YOUR_APP_PASSWORD_HERE",
        "FromEmail": "noreply@medicare.com",
        "FromName": "Medicare App"
    },
    "FrontendBaseUrl": "http://localhost:3000"
}