{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "UserServiceDb": ""
  },
  "Jwt": {
    "Issuer": "MedicareApp",
    "Audience": "MedicareUsers",
    "SecretKey": "",
    "ExpiryInMinutes": 15
  },
  "RefreshToken": {
    "ExpiryInDays": 7,
    "CookiePath": "/api/auth/refresh"
  },
  "Cookie": {
    "HttpOnly": true,
    "Secure": true,
    "SameSite": "None"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 1000,
    "WindowSeconds": 60,
    "QueueLimit": 10
  }
}