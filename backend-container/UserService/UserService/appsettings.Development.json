  },
  "Cookie": {
    "HttpOnly": true,
    "Secure": false,
    "SameSite": "Lax"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8080"
    ]
  }
}