{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Jwt": {
    "Issuer": "MedicareApp",
    "Audience": "MedicareUsers",
    "SecretKey": "DevelopmentSecretKeyForJWTTokens123456789ABCDEF",
    "ExpiryInMinutes": 15
