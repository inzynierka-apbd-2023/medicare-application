{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "MedicareApp",
    "Audience": "MedicareUsers",
    "SecretKey": "TestSecretKeyForJWTTokens123456789ABCDEF",
    "ExpiryInMinutes": 15
  },
  "RefreshToken": {
    "ExpiryInDays": 1,
    "CookiePath": "/api/auth/refresh"
  },
  "Cookie": {
    "HttpOnly": true,
    "Secure": false,
    "SameSite": "Lax"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  }
}