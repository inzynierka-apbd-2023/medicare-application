{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "azurecorsallowedorigins": {
      "value": "${AZURE_AZURECORSALLOWEDORIGINS}"
    },
    "azurefrontendbaseurl": {
      "value": "${AZURE_AZUREFRONTENDBASEURL}"
    },
    "azurejwtsecret": {
      "value": "${AZURE_AZUREJWTSECRET}"
    },
    "azurerabbitmqpassword": {
      "value": "${AZURE_AZURERABBITMQPASSWORD}"
    },
    "azuresmtppassword": {
      "value": "${AZURE_AZURESMTPPASSWORD}"
    },
    "azuresmtpusername": {
      "value": "${AZURE_AZURESMTPUSERNAME}"
    },
    "azurewebhookssecretmock": {
      "value": "${AZURE_AZUREWEBHOOKSSECRETMOCK}"
    },
    "azurewebhookssecretstripe": {
      "value": "${AZURE_AZUREWEBHOOKSSECRETSTRIPE}"
    },
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    }
  }
}