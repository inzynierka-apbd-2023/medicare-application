{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "principalId": {
        "value": "${AZURE_PRINCIPAL_ID}"
      },
      "frontend_base_url": {
        "value": "${AZURE_FRONTEND_BASE_URL}"
      },
      "jwt_secret": {
        "value": "${AZURE_JWT_SECRET}"
      },
      "rabbitmq_password": {
        "value": "${AZURE_RABBITMQ_PASSWORD}"
      },
      "smtp_password": {
        "value": "${AZURE_SMTP_PASSWORD}"
      },
      "smtp_username": {
        "value": "${AZURE_SMTP_USERNAME}"
      },
      "environmentName": {
        "value": "${AZURE_ENV_NAME}"
      },
      "location": {
        "value": "${AZURE_LOCATION}"
      }
    }
  }
  