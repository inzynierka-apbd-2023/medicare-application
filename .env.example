# Environment configuration for docker-compose
# Copy to .env and fill in values

# Environment (Development | Test | Production)
ASPNETCORE_ENVIRONMENT=Test

# Choose which Dockerfile to use for user-service (Dockerfile or Dockerfile.dev)
USER_SERVICE_DOCKERFILE=Dockerfile.dev

# # Connection string for UserService (Azure SQL - SQL auth example)
# USER_SERVICE_CONNECTION=Server=tcp:medicareapp-dbserver.database.windows.net,1433;Initial Catalog=medicare-db-dev;User Id=medicare_app;Password=ChangeMe!Strong1;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# If using AAD Default with host az login tokens, set connection string like:
USER_SERVICE_CONNECTION=Server=tcp:medicareapp-dbserver.database.windows.net,1433;Initial Catalog=medicare-db-dev;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;Authentication=Active Directory Default;
USE_AZURE_DEFAULT_CREDENTIAL=true

# Optional Azure AD Service Principal credentials (uncomment if implementing token acquisition logic)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Host Azure CLI token directory override (defaults to $HOME/.azure)
# HOST_AZURE_DIR=C:/Users/you/.azure
